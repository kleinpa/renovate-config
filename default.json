{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>kleinpa/renovate-config"],
  "timezone": "America/New_York",
  "automerge": true,
  "automergeType": "branch",
  "prHourlyLimit": 2,
  "dependencyDashboard": true,
  "packageRules": [
    {
      "groupName": "dev-tools",
      "matchDepTypes": ["devDependencies"],
      "schedule": ["* 0-8 1-7 * 1"]
    },
    {
      "matchManagers": ["bazel-module"],
      "matchPackageNames": [
        "bazel_skylib",
        "platforms",
        "rules_cc",
        "rules_distroless",
        "rules_oci",
        "rules_pkg",
        "rules_python"
      ],
      "groupName": "dev-tools",
      "schedule": ["* 0-8 1-7 * 1"]
    },
    {
      "matchManagers": [
        "github-actions",
        "devcontainer",
        "bazelisk",
        "terraform"
      ],
      "groupName": "dev-tools",
      "schedule": ["* 0-8 1-7 * 1"]
    }
  ]
}
